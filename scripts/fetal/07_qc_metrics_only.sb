#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=fetal_qcplot
#SBATCH --output=logs/fetal_qcplot.%j.out
# Plot QC distributions for every fetal sample whose Cell Ranger run has finished.
# NOTHING IS FILTERED -- this exists so the cutoffs get chosen by looking, not by default.
set -euo pipefail
set -a; source config.sh; set +a
# the single.cell env ships a newer libstdc++ than the system one; without this its pandas
# fails with "GLIBCXX_3.4.29 not found" (same two lines the single-cell-pipeline config.sh sets)
SC_ENV=/projects/hzhu10@xsede.org/software/anaconda/envs/single.cell
export LD_LIBRARY_PATH="$SC_ENV/lib:${LD_LIBRARY_PATH:-}"
export R_HOME="$SC_ENV/lib/R"
OUT="$FETAL_ROOT/qc_review"; mkdir -p "$OUT"
S="$OUT/samples.tsv"; : > "$S"
while IFS=$'\t' read -r task pool rest; do
  [[ "$task" == task ]] && continue
  printf '%s\twhole cells (Olaniru 2023)\t%s\n' "$pool" \
    "$FETAL_OUT/cellranger/$pool/outs/filtered_feature_bc_matrix.h5" >> "$S"
done < configs/fetal_olaniru_samples.tsv
while IFS=$'\t' read -r task sample rest; do
  [[ "$task" == task ]] && continue
  printf '%s\tnuclei (Migliorini 2024)\t%s\n' "$sample" \
    "$MIGL_OUT/cellranger/$sample/outs/filtered_feature_bc_matrix.h5" >> "$S"
done < configs/fetal_migliorini_samples.tsv
echo "candidate samples:"; cat "$S"
"$SC_ENV/bin/python" \
  scripts/fetal/07_qc_metrics_only.py --samples "$S" --outdir "$OUT"
