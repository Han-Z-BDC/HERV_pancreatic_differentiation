#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=24G
#SBATCH --time=04:00:00
#SBATCH --partition=ah200
#SBATCH --qos=gpu-normal
#SBATCH --gres=gpu:h200_2g.35gb:1
#SBATCH --job-name=fetal_scvi
#SBATCH --output=logs/fetal_scvi.%j.out
set -euo pipefail
SC=/projects/hzhu10@xsede.org/software/anaconda/envs/single.cell
export LD_LIBRARY_PATH="$SC/lib:${LD_LIBRARY_PATH:-}"
export R_HOME="$SC/lib/R"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
"$SC/bin/python" scripts/fetal/20_fetal_integrate.py --stage scvi "$@"
