#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=fetal_qcfilter
#SBATCH --output=logs/fetal_qcfilter.%j.out
# Apply the agreed QC cutoffs to the Olaniru pools and write the whitelists 05_irescue_fetal.sb uses.
set -euo pipefail
set -a; source config.sh; set +a
SC_ENV=/projects/hzhu10@xsede.org/software/anaconda/envs/single.cell
export LD_LIBRARY_PATH="$SC_ENV/lib:${LD_LIBRARY_PATH:-}"
export R_HOME="$SC_ENV/lib/R"
"$SC_ENV/bin/python" scripts/fetal/09_qc_filter.py \
  --samples configs/fetal_olaniru_samples.tsv \
  --cellranger "$FETAL_OUT/cellranger" \
  --geo-suppl "$FETAL_OUT/geo_suppl" \
  --outdir "$FETAL_OUT/qc_filtered"
