#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96G
#SBATCH --time=01:30:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=rematch
#SBATCH --output=logs/rematch.%j.out
set -euo pipefail
SC=/projects/hzhu10@xsede.org/software/anaconda/envs/single.cell
export LD_LIBRARY_PATH="$SC/lib:${LD_LIBRARY_PATH:-}"
export R_HOME="$SC/lib/R"
"$SC/bin/python" scripts/fetal/15_rematch_scrublet.py "$@"
