#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=fetal_prep
#SBATCH --output=logs/fetal_prep.%j.out
set -euo pipefail
SC=/projects/hzhu10@xsede.org/software/anaconda/envs/single.cell
export LD_LIBRARY_PATH="$SC/lib:${LD_LIBRARY_PATH:-}"
export R_HOME="$SC/lib/R"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
"$SC/bin/python" scripts/fetal/20_fetal_integrate.py --stage prep "$@"
