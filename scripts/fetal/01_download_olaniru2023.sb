#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --mem=16G
#SBATCH --job-name=dl_olaniru
#SBATCH --output=logs/dl_olaniru.%j.out
# Download Olaniru 2023 (GSE197064 / PRJNA808751) raw reads to scratch. acompile has internet.
# Run the dry run first (bash scripts/fetal/01_download_olaniru2023.sh), check sizes vs quota, then:
#   sbatch scripts/fetal/01_download_olaniru2023.sb --go
# acompile caps wall time at 12 h; the script is resumable, so just resubmit if it stops.
set -euo pipefail
bash scripts/fetal/01_download_olaniru2023.sh "$@"
